diff --git a/platform/ios/main_ios.mm b/platform/ios/main_ios.mm
index 7d61b8a..bbab34b 100644
--- a/platform/ios/main_ios.mm
+++ b/platform/ios/main_ios.mm
@@ -36,6 +36,9 @@
 #include "main/main.h"
 
 #import <UIKit/UIKit.h>
+#import <Foundation/Foundation.h>
+
+#include <dispatch/dispatch.h>
 
 #include <cstdio>
 
@@ -78,3 +81,27 @@ void apple_embedded_finish() {
 	godot_cleanup_profiler();
 	delete os;
 }
+
+void apple_embedded_restart_async(int argc, char **argv) {
+	NSMutableArray<NSString *> *arguments = [NSMutableArray arrayWithCapacity:argc];
+	for (int i = 0; i < argc; i++) {
+		[arguments addObject:[NSString stringWithUTF8String:argv[i]] ?: @""];
+	}
+	NSArray<NSString *> *restart_arguments = [arguments copy];
+	dispatch_async(dispatch_get_main_queue(), ^{
+		apple_embedded_finish();
+
+		int restart_argc = (int)restart_arguments.count;
+		char **restart_argv = (char **)malloc(sizeof(char *) * restart_argc);
+		for (int i = 0; i < restart_argc; i++) {
+			restart_argv[i] = strdup([restart_arguments[i] UTF8String]);
+		}
+
+		apple_embedded_main(restart_argc, restart_argv);
+
+		for (int i = 0; i < restart_argc; i++) {
+			free(restart_argv[i]);
+		}
+		free(restart_argv);
+	});
+}
