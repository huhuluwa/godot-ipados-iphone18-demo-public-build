+godot_plugins_initialize_fn initialize_coreclr_and_godot_plugins_for_editor(bool &r_runtime_initialized) {
+	godot_plugins_initialize_fn godot_plugins_initialize = nullptr;
+
+	const String managed_root = GodotSharpDirs::get_api_assemblies_dir();
+	const String native_root = OS::get_singleton()->get_executable_path().get_base_dir().path_join("Frameworks");
+	Ref<DirAccess> dir = DirAccess::open(managed_root);
+	ERR_FAIL_COND_V_MSG(dir.is_null(), nullptr, ".NET: Managed iOS editor directory is unavailable");
+
+	PackedStringArray managed_files;
+	dir->list_dir_begin();
+	String file_name = dir->get_next();
+	while (!file_name.is_empty()) {
+		if (!dir->current_is_dir() && file_name.ends_with(".dll")) {
+			managed_files.push_back(managed_root.path_join(file_name));
+		}
+		file_name = dir->get_next();
+	}
+	dir->list_dir_end();
+	ERR_FAIL_COND_V_MSG(managed_files.is_empty(), nullptr, ".NET: No managed iOS editor assemblies found");
+
+	String trusted_platform_assemblies;
+	for (const String &managed_file : managed_files) {
+		if (!trusted_platform_assemblies.is_empty()) {
+			trusted_platform_assemblies += ":";
+		}
+		trusted_platform_assemblies += managed_file;
+	}
+
+	CharString managed_root_utf8 = managed_root.utf8();
+	CharString native_root_utf8 = native_root.utf8();
+	CharString trusted_platform_assemblies_utf8 = trusted_platform_assemblies.utf8();
+	String runtime_deps_path = managed_root.path_join("Microsoft.NETCore.App.deps.json");
+	CharString runtime_deps_path_utf8 = runtime_deps_path.utf8();
+	const char *property_keys[] = {
+		"APP_PATHS",
+		"TRUSTED_PLATFORM_ASSEMBLIES",
+		"NATIVE_DLL_SEARCH_DIRECTORIES",
+		"APP_CONTEXT_BASE_DIRECTORY",
+		"SYSTEM_CORELIB_DIRECTORY",
+		"RUNTIME_IDENTIFIER",
+		"APP_CONTEXT_DEPS_FILES",
+		"FX_DEPS_FILE",
+		"APP_NI_PATHS",
+		"PLATFORM_RESOURCE_ROOTS",
+		"AppDomainCompatSwitch",
+	};
+	const char *property_values[] = {
+		managed_root_utf8.get_data(),
+		trusted_platform_assemblies_utf8.get_data(),
+		native_root_utf8.get_data(),
+		managed_root_utf8.get_data(),
+		managed_root_utf8.get_data(),
+#if defined(IOS_SIMULATOR)
+		"iossimulator-arm64",
+#else
+		"ios-arm64",
+#endif
+		runtime_deps_path_utf8.get_data(),
+		runtime_deps_path_utf8.get_data(),
+		managed_root_utf8.get_data(),
+		managed_root_utf8.get_data(),
+		"UseLatestBehaviorWhenTFMNotSpecified",
+	};
+
+	void *coreclr_handle = nullptr;
+	unsigned int domain_id = 0;
+	String executable_path = OS::get_singleton()->get_executable_path();
+	ERR_FAIL_COND_V_MSG(executable_path.is_empty(), nullptr, ".NET: iOS editor executable path is unavailable");
+	CharString executable_path_utf8 = executable_path.utf8();
+	coreclr_set_error_writer(coreclr_error_writer);
+	int rc = coreclr_initialize(executable_path_utf8.get_data(), "GodotEditor", (int)(sizeof(property_keys) / sizeof(property_keys[0])), property_keys, property_values, &coreclr_handle, &domain_id);
+	coreclr_set_error_writer(nullptr);
+	ERR_FAIL_COND_V_MSG(rc != 0, nullptr, ".NET: Failed to initialize CoreCLR on iOS editor");
+
+	r_runtime_initialized = true;
+	print_verbose(".NET: CoreCLR initialized for iOS editor");
+
+	rc = coreclr_create_delegate(coreclr_handle, domain_id,
+			"GodotPlugins",
+			"GodotPlugins.Main",
+			"InitializeFromEngine",
+			(void **)&godot_plugins_initialize);
+	ERR_FAIL_COND_V_MSG(rc != 0 || godot_plugins_initialize == nullptr, nullptr, ".NET: Failed to get GodotPlugins editor initialization function pointer");
+
+	return godot_plugins_initialize;
+}
+#endif
